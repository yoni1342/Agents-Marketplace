# Marketplace's OWN database (NOT Bench's). Create it once:
#   createdb agent_marketplace
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agent_marketplace

# Shared secret presented by Bench's backend in the X-Marketplace-Key header.
# Bench must set the SAME value as MARKETPLACE_API_KEY. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required in production; the dev default in config.py is intentionally weak.
MARKETPLACE_API_KEY=

# OPTIONAL — accept Bench's better-auth JWTs directly (for a future
# browser-direct integration). Point at Bench's JWKS + base URL. Leave blank
# for API-key-only mode (the default integration path).
#   https://bench.nova4.ai/api/auth/jwks
BETTER_AUTH_JWKS_URL=
BETTER_AUTH_URL=

# CORS origins for browser-direct calls (comma-separated). Not needed when
# only Bench's backend calls the service.
CORS_ORIGINS=http://localhost:3000
